{"code":200,"status":"OK","data":[{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"مِن شَرِّ مَا خَلَقَ","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"کہو کہ میں صبح کے پروردگار کی پناہ مانگتا ہوں","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"ہر چیز کی بدی سے جو اس نے پیدا کی","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"اور شب تاریکی کی برائی سے جب اس کااندھیرا چھا جائے","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"اور گنڈوں پر (پڑھ پڑھ کر) پھونکنے والیوں کی برائی سے","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"اور حسد کرنے والے کی برائی سے جب حسد کرنے لگے","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"SAY: \"I seek refuge with the Sustainer of the rising dawn,","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"\"from the evil of aught that He has created,","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"\"and from the evil of the black darkness whenever it descends,","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"\"and from the evil of all human beings bent on occult endeavours,","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"\"and from the evil of the envious when he envies.\"","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}