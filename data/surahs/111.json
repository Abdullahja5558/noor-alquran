{"code":200,"status":"OK","data":[{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"ابولہب کے ہاتھ ٹوٹیں اور وہ ہلاک ہو","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"نہ تو اس کا مال ہی اس کے کچھ کام آیا اور نہ وہ جو اس نے کمایا","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"وہ جلد بھڑکتی ہوئی آگ میں داخل ہو گا","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"اور اس کی جورو بھی جو ایندھن سر پر اٹھائے پھرتی ہے","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"اس کے گلے میں مونج کی رسّی ہو گی","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"DOOMED are the hands of him of the glowing countence: and doomed is he!","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"What will his wealth avail him, and all that he has gained?","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"[In the life to come] he shall have to endure a fire fiercely glowing;","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"together with his wife, that carrier of evil tales,","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"[who bears] around her neck a rope of twisted strands!","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}