{"code":200,"status":"OK","data":[{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"قریش کے مانوس کرنے کے سبب","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"(یعنی) ان کو جاڑے اور گرمی کے سفر سے مانوس کرنے کے سبب","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"لوگوں کو چاہیئے کہ (اس نعمت کے شکر میں) اس گھر کے مالک کی عبادت کریں","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"جس نے ان کو بھوک میں کھانا کھلایا اور خوف سے امن بخشا","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"SO THAT the Quraysh might remain secure,","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"secure in their winter and summer journeys,","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"Let them, therefore, worship the Sustainer of this Temple;","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"who has given them food against hunger, and made them safe from danger.","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}