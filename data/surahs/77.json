مور میں) تاخیر کس دن کے لئے کی گئی؟","numberInSurah":12,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5635,"text":"فیصلے کے دن کے لئے","numberInSurah":13,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5636,"text":"اور تمہیں کیا خبر کہ فیصلے کا دن کیا ہے؟","numberInSurah":14,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5637,"text":"اس دن جھٹلانے والوں کے لئے خرابی ہے","numberInSurah":15,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5638,"text":"کیا ہم نے پہلے لوگوں کو ہلاک نہیں کر ڈالا","numberInSurah":16,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5639,"text":"پھر ان پچھلوں کو بھی ان کے پیچھے بھیج دیتے ہیں","numberInSurah":17,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5640,"text":"ہم گنہگاروں کے ساتھ ایسا ہی کیا کرتے ہیں","numberInSurah":18,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5641,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":19,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5642,"text":"کیا ہم نے تم کو حقیر پانی سے نہیں پیدا کیا؟","numberInSurah":20,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5643,"text":"اس کو ایک محفوظ جگہ میں رکھا","numberInSurah":21,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5644,"text":"ایک وقت معین تک","numberInSurah":22,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5645,"text":"پھر اندازہ مقرر کیا اور ہم کیا ہی خوب اندازہ مقرر کرنے والے ہیں","numberInSurah":23,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5646,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":24,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5647,"text":"کیا ہم نے زمین کو سمیٹنے والی نہیں بنایا","numberInSurah":25,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5648,"text":"یعنی) زندوں اور مردوں کو","numberInSurah":26,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5649,"text":"(بنایا) اور اس پر اونچے اونچے پہاڑ رکھ دیئے اور تم لوگوں کو میٹھا پانی پلایا","numberInSurah":27,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5650,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":28,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5651,"text":"جس چیز کو تم جھٹلایا کرتے تھے۔ (اب) اس کی طرف چلو","numberInSurah":29,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5652,"text":"(یعنی) اس سائے کی طرف چلو جس کی تین شاخیں ہیں","numberInSurah":30,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5653,"text":"نہ ٹھنڈی چھاؤں اور نہ لپٹ سے بچاؤ","numberInSurah":31,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5654,"text":"اس سے (آگ کی اتنی اتنی بڑی) چنگاریاں اُڑتی ہیں جیسے محل","numberInSurah":32,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5655,"text":"گویا زرد رنگ کے اونٹ ہیں","numberInSurah":33,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5656,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":34,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5657,"text":"یہ وہ دن ہے کہ (لوگ) لب تک نہ ہلا سکیں گے","numberInSurah":35,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5658,"text":"اور نہ ان کو اجازت دی جائے گی کہ عذر کرسکیں","numberInSurah":36,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5659,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":37,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5660,"text":"یہی فیصلے کا دن ہے (جس میں) ہم نے تم کو اور پہلے لوگوں کو جمع کیا ہے","numberInSurah":38,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5661,"text":"اگر تم کو کوئی داؤں آتا ہو تو مجھ سے کر لو","numberInSurah":39,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5662,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":40,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5663,"text":"بےشک پرہیزگار سایوں اور چشموں میں ہوں گے","numberInSurah":41,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5664,"text":"اور میؤوں میں جو ان کو مرغوب ہوں","numberInSurah":42,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5665,"text":"اور جو عمل تم کرتے رہے تھے ان کے بدلے میں مزے سے کھاؤ اور پیو","numberInSurah":43,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5666,"text":"ہم نیکو کاروں کو ایسا ہی بدلہ دیا کرتے ہیں","numberInSurah":44,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5667,"text":"اس دن جھٹلانے والوں کی خرابی ہوگی","numberInSurah":45,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5668,"text":"(اے جھٹلانے والو!) تم کسی قدر کھا لو اور فائدے اُٹھا لو تم بےشک گنہگار ہو","numberInSurah":46,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5669,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":47,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5670,"text":"اور جب ان سے کہا جاتا ہے کہ (خدا کے آگے) جھکو تو جھکتے نہیں","numberInSurah":48,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5671,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":49,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5672,"text":"اب اس کے بعد یہ کون سی بات پر ایمان لائیں گے؟","numberInSurah":50,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelationType":"Meccan","numberOfAyahs":50,"ayahs":[{"number":5623,"text":"CONSIDER these [messages,] sent forth in waves","numberInSurah":1,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5624,"text":"and then storming on with a tempest's force!","numberInSurah":2,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5625,"text":"Consider these [messages] that spread [the truth] far and wide,","numberInSurah":3,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5626,"text":"thus separating [right and wrong] with all clarity,","numberInSurah":4,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5627,"text":"and then giving forth a reminder,","numberInSurah":5,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5628,"text":"[promising] freedom from blame or [offering] a warning!","numberInSurah":6,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5629,"text":"BEHOLD, all that you are told to expect will surely come to pass.","numberInSurah":7,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5630,"text":"Thus, [it will come to pass] when the stars are effaced,","numberInSurah":8,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5631,"text":"and when the sky is rent asunder,","numberInSurah":9,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5632,"text":"and when the mountains are scattered like dust,","numberInSurah":10,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5633,"text":"and when all the apostles are called together at a time appointed...","numberInSurah":11,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5634,"text":"For what day has the term [of all this] been set?","numberInSurah":12,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5635,"text":"For the Day of Distinction [between the true and the false]!","numberInSurah":13,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5636,"text":"And what could make thee conceive what that Day of Distinction will be?","numberInSurah":14,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5637,"text":"Woe on that Day unto those who give the lie to the truth!","numberInSurah":15,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5638,"text":"Did We not destroy [so many of] those [sinners] of olden days?","numberInSurah":16,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5639,"text":"And We shall let them be followed by those of later times:","numberInSurah":17,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5640,"text":"[for] thus do We deal with such as are lost in sin.","numberInSurah":18,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5641,"text":"Woe on that Day unto those who give the lie to the truth!","numberInSurah":19,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5642,"text":"Did We not create you out of a humble fluid","numberInSurah":20,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5643,"text":"which We then let remain in [the womb's] firm keeping","numberInSurah":21,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5644,"text":"for a term pre-ordained?","numberInSurah":22,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5645,"text":"Thus have We determined [the nature of man's creation]: and excellent indeed is Our power to determine [what is to be]!","numberInSurah":23,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5646,"text":"Woe, on that Day unto those who give the lie to the truth!","numberInSurah":24,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5647,"text":"Have We not caused the earth to hold within itself","numberInSurah":25,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5648,"text":"the living and the dead?","numberInSurah":26,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5649,"text":"and have We not set on it proud, firm mountains, and given you sweet water to drink?","numberInSurah":27,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5650,"text":"Woe on that Day unto those who give the lie to the truth!","numberInSurah":28,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5651,"text":"GO ON towards that [resurrection] which you were wont to call a lie!","numberInSurah":29,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5652,"text":"Go on towards the threefold shadow","numberInSurah":30,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5653,"text":"that will offer no [cooling] shade and will be of no avail against the flame","numberInSurah":31,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5654,"text":"which – behold!- will throw up sparks like [burning] logs,","numberInSurah":32,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5655,"text":"like giant fiery ropes!","numberInSurah":33,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5656,"text":"Woe on that Day unto those who give the lie to the truth –","numberInSurah":34,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5657,"text":"that Day on which they will not [be able to] utter a word,","numberInSurah":35,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5658,"text":"nor be allowed to proffer excuses!","numberInSurah":36,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5659,"text":"Woe on that Day unto those who give the lie to the truth –","numberInSurah":37,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5660,"text":"that Day of Distinction [between the true and the false, when they will be told]: \"We have brought you together with those [sinners] of olden times;","numberInSurah":38,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5661,"text":"and if you [think that you] have a subterfuge left, try to outwit Me!\"","numberInSurah":39,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5662,"text":"Woe on that Day unto those who give the lie to the truth!","numberInSurah":40,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5663,"text":"[AS AGAINST this,] behold, the God-conscious shall dwell amidst [cooling] shades and springs,","numberInSurah":41,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5664,"text":"and [partake of] whatever fruit they may desire;","numberInSurah":42,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5665,"text":"[and they will be told:] \"Eat and drink in good cheer in return for what you did [in life]!\"","numberInSurah":43,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5666,"text":"Thus, behold, do We reward the doers of good;","numberInSurah":44,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5667,"text":"[but] woe on that Day unto those who give the lie to the truth!","numberInSurah":45,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5668,"text":"EAT [your fill] and enjoy your life for a little while, O you who are lost in sin!","numberInSurah":46,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5669,"text":"[But] woe on that Day unto those who give the lie to the truth,","numberInSurah":47,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5670,"text":"and when they are told, \"Bow down [before God]\", do not bow down:","numberInSurah":48,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5671,"text":"woe on that Day unto those who give the to the truth!","numberInSurah":49,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5672,"text":"In what other tiding, then, will they, after this, believe?","numberInSurah":50,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}