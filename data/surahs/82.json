{"code":200,"status":"OK","data":[{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"كِرَامًۭا كَٰتِبِينَ","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"جب آسمان پھٹ جائے گا","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"اور جب تارے جھڑ پڑیں گے","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"اور جب قبریں اکھیڑ دی جائیں گی","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"اور جس صورت میں چاہا تجھے جوڑ دیا","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"حالانکہ تم پر نگہبان مقرر ہیں","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"عالی قدر (تمہاری باتوں کے) لکھنے والے","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"جو تم کرتے ہو وہ اسے جانتے ہیں","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"اور بدکردار دوزخ میں","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"(یعنی) جزا کے دن اس میں داخل ہوں گے","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"اور اس سے چھپ نہیں سکیں گے","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"اور تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"پھر تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"جس روز کوئی کسی کا بھلا نہ کر سکے گا اور حکم اس روز خدا ہی کا ہو گا","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"WHEN THE SKY is cleft asunder,","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"and when the stars are scattered,","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"and when the seas burst beyond their bounds,","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"and when the graves are overturned –","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"every human being will [at last] comprehend, what he has sent ahead and what he has held back [in this world].","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"O MAN! What is it that lures thee away from thy bountiful Sustainer,","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"who has created thee, and formed thee in accordance with what thou art meant' to be, and shaped thy nature in just proportions,","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"having put thee together in whatever form He willed [thee to have]?","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"Nay, [O men,] but you [are lured away from God whenever you are tempted to] give the lie to [God’s] Judgment!","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"And yet, verily, there are ever-watchful forces over you,","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"noble, recording,","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"aware of whatever you do!","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"Behold, [in the life to come] the truly virtuous: will indeed be in bliss,","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"whereas, behold, the wicked will indeed be in a blazing fire –","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"[a fire] which they shall enter on Judgment Day,","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"and which they shall not [be able to] evade.","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"And what could make thee conceive what that Judgment Day will be?","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"And once again: What could make thee conceive what that Judgment Day will be?","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"[It will be] a Day when no human being shall be of the least avail to another human being: for on that Day [it will become manifest that] all sovereignty is God's alone.","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}