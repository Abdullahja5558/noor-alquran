{"code":200,"status":"OK","data":[{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"آفتاب کی روشنی کی قسم","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"اور رات (کی تاریکی) کی جب چھا جائے","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"کہ (اے محمدﷺ) تمہارے پروردگار نے نہ تو تم کو چھوڑا اور نہ (تم سے) ناراض ہوا","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"اور آخرت تمہارے لیے پہلی (حالت یعنی دنیا) سے کہیں بہتر ہے","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"اور تمہیں پروردگار عنقریب وہ کچھ عطا فرمائے گا کہ تم خوش ہو جاؤ گے","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"بھلا اس نے تمہیں یتیم پا کر جگہ نہیں دی؟ (بےشک دی)","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"اور رستے سے ناواقف دیکھا تو رستہ دکھایا","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"اور تنگ دست پایا تو غنی کر دیا","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"تو تم بھی یتیم پر ستم نہ کرنا","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"اور مانگنے والے کو جھڑکی نہ دینا","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"اور اپنے پروردگار کی نعمتوں کا بیان کرتے رہنا","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","ayahs":[{"number":6080,"text":"By the morning brightness","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"And [by] the night when it covers with darkness,","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you].","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"And the Hereafter is better for you than the first [life].","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"And your Lord is going to give you, and you will be satisfied.","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"Did He not find you an orphan and give [you] refuge?","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"And He found you lost and guided [you],","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"And He found you poor and made [you] self-sufficient.","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"So as for the orphan, do not oppress [him].","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"And as for the petitioner, do not repel [him].","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"But as for the favor of your Lord, report [it].","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}]}]}