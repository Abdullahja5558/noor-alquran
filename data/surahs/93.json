{"code":200,"status":"OK","data":[{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"آفتاب کی روشنی کی قسم","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"اور رات (کی تاریکی) کی جب چھا جائے","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"کہ (اے محمدﷺ) تمہارے پروردگار نے نہ تو تم کو چھوڑا اور نہ (تم سے) ناراض ہوا","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"اور آخرت تمہارے لیے پہلی (حالت یعنی دنیا) سے کہیں بہتر ہے","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"اور تمہیں پروردگار عنقریب وہ کچھ عطا فرمائے گا کہ تم خوش ہو جاؤ گے","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"بھلا اس نے تمہیں یتیم پا کر جگہ نہیں دی؟ (بےشک دی)","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"اور رستے سے ناواقف دیکھا تو رستہ دکھایا","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"اور تنگ دست پایا تو غنی کر دیا","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"تو تم بھی یتیم پر ستم نہ کرنا","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"اور مانگنے والے کو جھڑکی نہ دینا","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"اور اپنے پروردگار کی نعمتوں کا بیان کرتے رہنا","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"CONSIDER the bright morning hours,","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"and the night when it grows still and dark.","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"Thy Sustainer has not forsaken thee, nor does He scorn thee:","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"for, indeed, the life to come will be better for thee than this earlier part [of thy life]!","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"And, indeed, in time will thy Sustainer grant thee [what thy heart desires], and thou shalt be well-pleased.","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"Has He not found thee an orphan, and given thee shelter?","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"And found thee lost on thy way, and guided thee?","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"And found thee in want, and given thee sufficiency?","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"Therefore, the orphan shalt thou never wrong,","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"and him that seeks [thy] help shalt thou never chide,","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"and of thy Sustainer's blessings shalt thou [ever] speak.","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}