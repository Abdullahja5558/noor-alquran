َّىٰ","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"ہم کو روز قیامت کی قسم","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5553,"text":"اور نفس لوامہ کی (کہ سب لوگ اٹھا کر) کھڑے کئے جائیں گے","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5554,"text":"کیا انسان یہ خیال کرتا ہے کہ ہم اس کی (بکھری ہوئی) ہڈیاں اکٹھی نہیں کریں گے؟","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5555,"text":"ضرور کریں گے (اور) ہم اس بات پر قادر ہیں کہ اس کی پور پور درست کردیں","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5556,"text":"مگر انسان چاہتا ہے کہ آگے کو خود سری کرتا جائے","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5557,"text":"پوچھتا ہے کہ قیامت کا دن کب ہوگا؟","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5558,"text":"جب آنکھیں چندھیا جائیں","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5559,"text":"اور چاند گہنا جائے","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5560,"text":"اور سورج اور چاند جمع کردیئے جائیں","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5561,"text":"اس دن انسان کہے گا کہ (اب) کہاں بھاگ جاؤں؟","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5562,"text":"بےشک کہیں پناہ نہیں","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5563,"text":"اس روز پروردگار ہی کے پاس ٹھکانا ہے","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5564,"text":"اس دن انسان کو جو (عمل) اس نے آگے بھیجے اور پیچھے چھوڑے ہوں گے سب بتا دیئے جائیں گے","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5565,"text":"بلکہ انسان آپ اپنا گواہ ہے","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5566,"text":"اگرچہ عذر ومعذرت کرتا رہے","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5567,"text":"اور (اے محمدﷺ) وحی کے پڑھنے کے لئے اپنی زبان نہ چلایا کرو کہ اس کو جلد یاد کرلو","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5568,"text":"اس کا جمع کرنا اور پڑھانا ہمارے ذمے ہے","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5569,"text":"جب ہم وحی پڑھا کریں تو تم (اس کو سنا کرو اور) پھر اسی طرح پڑھا کرو","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5570,"text":"پھر اس (کے معانی) کا بیان بھی ہمارے ذمے ہے","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5571,"text":"مگر (لوگو) تم دنیا کو دوست رکھتے ہو","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5572,"text":"اور آخرت کو ترک کئے دیتے ہو","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5573,"text":"اس روز بہت سے منہ رونق دار ہوں گے","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5574,"text":"اور) اپنے پروردگار کے محو دیدار ہوں گے","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5575,"text":"اور بہت سے منہ اس دن اداس ہوں گے","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5576,"text":"خیال کریں گے کہ ان پر مصیبت واقع ہونے کو ہے","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5577,"text":"دیکھو جب جان گلے تک پہنچ جائے","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5578,"text":"اور لوگ کہنے لگیں (اس وقت) کون جھاڑ پھونک کرنے والا ہے","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5579,"text":"اور اس (جان بلب) نے سمجھا کہ اب سب سے جدائی ہے","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5580,"text":"اور پنڈلی سے پنڈلی لپٹ جائے","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5581,"text":"اس دن تجھ کو اپنے پروردگار کی طرف چلنا ہے","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5582,"text":"تو اس (ناعاقبت) اندیش نے نہ تو (کلام خدا) کی تصدیق کی نہ نماز پڑھی","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5583,"text":"بلکہ جھٹلایا اور منہ پھیر لیا","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5584,"text":"پھر اپنے گھر والوں کے پاس اکڑتا ہوا چل دیا","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5585,"text":"افسوس ہے تجھ پر پھر افسوس ہے","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5586,"text":"پھر افسوس ہے تجھ پر پھر افسوس ہے","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5587,"text":"کیا انسان خیال کرتا ہے کہ یوں ہی چھوڑ دیا جائے گا؟","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5588,"text":"کیا وہ منی کا جو رحم میں ڈالی جاتی ہے ایک قطرہ نہ تھا؟","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5589,"text":"پھر لوتھڑا ہوا پھر (خدا نے) اس کو بنایا پھر (اس کے اعضا کو) درست کیا","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"پھر اس کی دو قسمیں بنائیں (ایک) مرد اور (ایک) عورت","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"کیا اس خالق کو اس بات پر قدرت نہیں کہ مردوں کو جلا اُٹھائے؟","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"NAY! I call to witness the Day of Resurrection!","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5553,"text":"But nay! I call to witness the accusing voice of man's own conscience!","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5554,"text":"Does man think that We cannot [resurrect him and] bring his bones together again?","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5555,"text":"Yea indeed, We are able to make whole his very finger-tips!","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5556,"text":"None the less man chooses to deny what lies ahead of him,","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5557,"text":"asking [derisively], \"When is that Resurrection Day to be?\"","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5558,"text":"But [on that Day,] when the eyesight is by fear confounded,","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5559,"text":"and the moon is darkened,","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5560,"text":"and the sun and the moon are brought together","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5561,"text":"on that Day will man exclaim \"Whither to flee?\"","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5562,"text":"But nay: no refuge [for thee, O man]!","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5563,"text":"With thy Sustainer, on that Day, the journey's end will be!","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5564,"text":"Man will be apprised, on that Day, of what he has done and what he has left undone:","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5565,"text":"nay, but man shall against himself be an eye-witness,","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5566,"text":"even though he may veil himself in excuses.","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5567,"text":"MOVE NOT thy tongue in haste, [repeating the words of the revelation:]","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5568,"text":"for, behold, it is for Us to gather it [in thy heart,] and to cause it to be read [as it ought to be read].","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5569,"text":"Thus, when We recite it, follow thou its wording [with all thy mind]:","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5570,"text":"and then, behold, it will be for Us to make its meaning clear.","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5571,"text":"NAY, but [most of] you love this fleeting life,","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5572,"text":"and give no thought to the life to come [and to Judgment Day]!","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5573,"text":"Some faces will on that Day be bright with happiness,","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5574,"text":"looking up to their Sustainer;","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5575,"text":"and some faces will on that Day be overcast with despair,","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5576,"text":"knowing that a crushing calamity is about to befall them.","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5577,"text":"NAY, but when [the last breath] comes up to the throat [of a dying man],","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5578,"text":"and people ask, \"Is there any wizard [that could save him]?\"","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5579,"text":"the while he [himself] knows that this is the parting,","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5580,"text":"and is enwrapped in the pangs of death","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5581,"text":"at that time towards thy Sustainer does he feel impelled to turn!","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5582,"text":"[Useless, though, will be his repentance: for [as long as he was alive] he did not accept the truth, nor did he pray [for enlightenment],","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5583,"text":"but, on the contrary, he gave the lie to the truth and turned away [from it],","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5584,"text":"and then went arrogantly back to what he had come from.","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5585,"text":"[And yet, O man, thine end comes hourly] nearer unto thee, and nearer –","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5586,"text":"and ever nearer unto thee, and nearer!","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5587,"text":"DOES MAN, then, think that he is to be left to himself to go about at will?","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5588,"text":"Was he not once a [mere] drop of sperm that had been spilt,","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5589,"text":"and thereafter became a germ-cell - whereupon He created and formed [it] in accordance with what [it] was meant to be,","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"and fashioned out of it the two sexes, the male and the female?","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"Is not He, then; able to bring the dead back to life?","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}