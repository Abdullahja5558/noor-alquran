{"code":200,"status":"OK","data":[{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6190,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6191,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6192,"text":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6193,"text":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے ہاتھی والوں کے ساتھ کیا کیا","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6190,"text":"کیا ان کا داؤں غلط نہیں کیا؟ (گیا)","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6191,"text":"اور ان پر جھلڑ کے جھلڑ جانور بھیجے","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6192,"text":"جو ان پر کھنگر کی پتھریاں پھینکتے تھے","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6193,"text":"تو ان کو ایسا کر دیا جیسے کھایا ہوا بھس","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"ART THOU NOT aware of how thy Sustainer dealt with the Army of the Elephant?","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6190,"text":"Did He not utterly confound their artful planning?","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6191,"text":"Thus, He let loose upon them great swarms of flying creatures","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6192,"text":"which smote them with stone-hard blows of chastisement pre-ordained,","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6193,"text":"and caused them to become like a field of grain that has been eaten down to stubble","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}