{"code":200,"status":"OK","data":[{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"(اے محمدﷺ) ہم نے تم کو کوثر عطا فرمائی ہے","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"تو اپنے پروردگار کے لیے نماز پڑھا کرو اور قربانی دیا کرو","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"کچھ شک نہیں کہ تمہارا دشمن ہی بےاولاد رہے گا","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"BEHOLD, We have bestowed upon thee good in abundance:","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"hence, pray unto thy Sustainer [alone], and sacrifice [unto Him alone].","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"Verily, he that hates thee has indeed been cut off [from all that is good]!","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}