{"code":200,"status":"OK","data":[{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"فَأَيْنَ تَذْهَبُونَ","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"جب سورج لپیٹ لیا جائے گا","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"جب تارے بےنور ہو جائیں گے","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"اور جب پہاڑ چلائے جائیں گے","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"اور جب وحشی جانور جمع اکٹھے ہو جائیں گے","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"اور جب دریا آگ ہو جائیں گے","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"اور جب روحیں (بدنوں سے) ملا دی جائیں گی","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"کہ وہ کس گناہ پرماری گئی","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"اور جب (عملوں کے) دفتر کھولے جائیں گے","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"اور جب آسمانوں کی کھال کھینچ لی جائے گی","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"اور جب دوزخ (کی آگ) بھڑکائی جائے گی","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"اور بہشت جب قریب لائی جائے گی","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"(اور) جو سیر کرتے اور غائب ہو جاتے ہیں","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"اور رات کی قسم جب ختم ہونے لگتی ہے","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"اور صبح کی قسم جب نمودار ہوتی ہے","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"سردار (اور) امانت دار ہے","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"بےشک انہوں نے اس (فرشتے) کو (آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"اور یہ شیطان مردود کا کلام نہیں","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"پھر تم کدھر جا رہے ہو","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"یہ تو جہان کے لوگوں کے لیے نصیحت ہے","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"WHEN THE SUN is shrouded in darkness,","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"and when the stars lose their light,","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"and when the mountains are made to vanish,","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"and when she-camels big with young, about to give birth, are left untended,","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"and when all beasts are gathered together,","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"and when the seas boil over,","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"and when all human beings are coupled [with their deeds],","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"and when the girl-child that was buried alive is made to ask","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"for what crime she had been slain,","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"and when the scrolls [of men's deeds] are unfolded,","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"and when heaven is laid bare,","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"and when the blazing fire [of hell] is kindled bright,","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"and when paradise is brought into view:","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"[on that Day] every human being will come to know what he has prepared [for himself].","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"BUT NAY! I call to witness the revolving stars,","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"the planets that run their course and set,","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"and the night as it darkly falls,","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"and the morn as it softly breathes:","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"behold, this [divine writ] is indeed the [inspired] word of a noble apostle,","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"with strength endowed, secure with Him who in almightiness is enthroned","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"[the word] of one to be heeded, and worthy of trust!","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"For, this fellow-man of yours is not a madman:","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"he truly beheld [the angel - beheld] him on the clear horizon;","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"and he is not one to begrudge others the knowledge [of whatever has been revealed to him] out of that which is beyond the reach of human Perception.","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"Nor is this [message] the word of any satanic force accursed.","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"Whither, then, will you go?","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"This [message] is no less than a reminder to all mankind –","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"to everyone of you who wills to walk a straight way.","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"But you cannot will it unless God, the Sustainer of all the worlds, wills [to show you that way].","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}