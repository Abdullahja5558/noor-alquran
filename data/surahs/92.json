{"code":200,"status":"OK","data":[{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6077,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"وَلَسَوْفَ يَرْضَىٰ","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"رات کی قسم جب (دن کو) چھپالے","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"اور دن کی قسم جب چمک اٹھے","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"اور اس (ذات) کی قسم جس نے نر اور مادہ پیدا کیے","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"کہ تم لوگوں کی کوششں طرح طرح کی ہے","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"تو جس نے (خدا کے رستے میں مال) دیا اور پرہیز گاری کی","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"اور نیک بات کو سچ جانا","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"اس کو ہم آسان طریقے کی توفیق دیں گے","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"اور جس نے بخل کیا اور بےپروا بنا رہا","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"اور نیک بات کو جھوٹ سمجھا","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"اسے سختی میں پہنچائیں گے","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"اور جب وہ (دوزخ کے گڑھے میں) گرے گا تو اس کا مال اس کے کچھ کام نہ آئے گا","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"ہمیں تو راہ دکھا دینا ہے","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"اور آخرت او ردنیا ہماری ہی چیزیں ہیں","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"سو میں نے تم کو بھڑکتی آگ سے متنبہ کر دیا","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"اس میں وہی داخل ہو گا جو بڑا بدبخت ہے","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"جس نے جھٹلایا اور منہ پھیرا","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"اور جو بڑا پرہیزگار ہے وہ (اس سے) بچا لیا جائے گا","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"جو مال دیتا ہے تاکہ پاک ہو","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6077,"text":"اور (اس لیے) نہیں (دیتا کہ) اس پر کسی کا احسان (ہے) جس کا وہ بدلہ اتارتا ہے","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"بلکہ اپنے خداوند اعلیٰ کی رضامندی حاصل کرنے کے لیے دیتا ہے","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"اور وہ عنقریب خوش ہو جائے گا","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","ayahs":[{"number":6059,"text":"By the night when it covers","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"And [by] the day when it appears","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"And [by] He who created the male and female,","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"Indeed, your efforts are diverse.","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"As for he who gives and fears Allah","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"And believes in the best [reward],","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"We will ease him toward ease.","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"But as for he who withholds and considers himself free of need","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"And denies the best [reward],","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"We will ease him toward difficulty.","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"And what will his wealth avail him when he falls?","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"Indeed, [incumbent] upon Us is guidance.","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"And indeed, to Us belongs the Hereafter and the first [life].","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"So I have warned you of a Fire which is blazing.","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"None will [enter to] burn therein except the most wretched one.","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"Who had denied and turned away.","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"But the righteous one will avoid it -","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"[He] who gives [from] his wealth to purify himself","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6077,"text":"And not [giving] for anyone who has [done him] a favor to be rewarded","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"But only seeking the countenance of his Lord, Most High.","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"And he is going to be satisfied.","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}]}]}