{"code":200,"status":"OK","data":[{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6045,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6046,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6047,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6048,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6049,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6050,"text":"وَنَفْسٍۢ وَمَا سَوَّىٰهَا","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6051,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6052,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6053,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6054,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6055,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6056,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"وَلَا يَخَافُ عُقْبَٰهَا","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"سورج کی قسم اور اس کی روشنی کی","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6045,"text":"اور چاند کی جب اس کے پیچھے نکلے","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6046,"text":"اور دن کی جب اُسے چمکا دے","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6047,"text":"اور رات کی جب اُسے چھپا لے","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6048,"text":"اور آسمان کی اور اس ذات کی جس نے اسے بنایا","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6049,"text":"اور زمین کی اور اس کی جس نے اسے پھیلایا","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6050,"text":"اور انسان کی اور اس کی جس نے اس (کے اعضا) کو برابر کیا","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6051,"text":"پھر اس کو بدکاری (سے بچنے) اور پرہیزگاری کرنے کی سمجھ دی","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6052,"text":"کہ جس نے (اپنے) نفس (یعنی روح) کو پاک رکھا وہ مراد کو پہنچا","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6053,"text":"اور جس نے اسے خاک میں ملایا وہ خسارے میں رہا","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6054,"text":"(قوم) ثمود نے اپنی سرکشی کے سبب (پیغمبر کو) جھٹلایا","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6055,"text":"جب ان میں سے ایک نہایت بدبخت اٹھا","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6056,"text":"تو خدا کے پیغمبر (صالح) نے ان سے کہا کہ خدا کی اونٹنی اور اس کے پانی پینے کی باری سے عذر کرو","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"مگر انہوں نے پیغمبر کو جھٹلایا اور اونٹنی کی کونچیں کاٹ دیں تو خدا نے ان کےگناہ کے سبب ان پر عذاب نازل کیا اور سب کو (ہلاک کر کے) برابر کر دیا","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"اور اس کو ان کے بدلہ لینے کا کچھ بھی ڈر نہیں","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"CONSIDER the sun and its radiant brightness,","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6045,"text":"and the moon as it reflects the sun!","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6046,"text":"Consider the day as it reveals the world,","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6047,"text":"and the night as it veils it darkly!","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6048,"text":"Consider the sky and its wondrous make,","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6049,"text":"and the earth and all its expanse!","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6050,"text":"Consider the human self, and how it is formed in accordance with what it is meant to be,","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6051,"text":"and how it is imbued with moral failings as well as with consciousness of God!","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6052,"text":"To a happy state shall indeed attain he who causes this [self] to grow in purity,","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6053,"text":"and truly lost is he who buries it [in darkness].","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6054,"text":"TO [THIS] TRUTH gave the lie, in their overweening arrogance, [the tribe of] Thamud,","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6055,"text":"when that most hapless wretch from among them rushed forward [to commit his evil deed],","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6056,"text":"although God's apostle had told them, \"It is a she-camel belonging to God, so let her drink [and do her no harm]!\"","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"But they gave him the lie, and cruelly slaughtered her - whereupon their Sustainer visited them with utter destruction for this their sin, destroying them all alike:","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"for none [of them] had any fear of what might befall them.","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}