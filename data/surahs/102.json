{"code":200,"status":"OK","data":[{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"(لوگو) تم کو (مال کی) بہت سی طلب نے غافل کر دیا","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"یہاں تک کہ تم نے قبریں جا دیکھیں","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"دیکھو تمہیں عنقریب معلوم ہو جائے گا","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"پھر دیکھو تمہیں عنقریب معلوم ہو جائے گا","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"دیکھو اگر تم جانتے (یعنی) علم الیقین (رکھتے تو غفلت نہ کرتے)","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"تم ضرور دوزخ کو دیکھو گے","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"پھر اس کو (ایسا) دیکھو گے (کہ) عین الیقین (آ جائے گا)","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"پھر اس روز تم سے (شکر) نعمت کے بارے میں پرسش ہو گی","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"YOU ARE OBSESSED by greed for more and more","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"until you go down to your graves.","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"Nay, in time you will come to understand!","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"And once again: Nay, in time you will come to understand!","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"Nay, if you could but understand [it] with an understanding [born] of certainty,","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"you would indeed, most surely, behold the blazing fire [of hell]!","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"In the end you will indeed, most surely, behold it with the eye of certainty:","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"and on that Day you will most surely be called to account for [what you did with] the boon of life!","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}