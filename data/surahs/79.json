3,"sajda":false},{"number":5715,"text":"اور ان کی جو تیرتے پھرتے ہیں","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5716,"text":"پھر لپک کر آگے بڑھتے ہیں","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5717,"text":"پھر (دنیا کے) کاموں کا انتظام کرتے ہیں","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5718,"text":"(کہ وہ دن آ کر رہے گا) جس دن زمین کو بھونچال آئے گا","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5719,"text":"پھر اس کے پیچھے اور (بھونچال) آئے گا","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5720,"text":"اس دن (لوگوں) کے دل خائف ہو رہے ہوں گے","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5721,"text":"اور آنکھیں جھکی ہوئی","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5722,"text":"(کافر) کہتے ہیں کیا ہم الٹے پاؤں پھر لوٹ جائیں گے","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5723,"text":"بھلا جب ہم کھوکھلی ہڈیاں ہو جائیں گے (تو پھر زندہ کئے جائیں گے)","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5724,"text":"کہتے ہیں کہ یہ لوٹنا تو (موجب) زیاں ہے","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5725,"text":"وہ تو صرف ایک ڈانٹ ہوگی","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5726,"text":"اس وقت وہ (سب) میدان (حشر) میں آ جمع ہوں گے","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5727,"text":"بھلا تم کو موسیٰ کی حکایت پہنچی ہے","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5728,"text":"جب اُن کے پروردگار نے ان کو پاک میدان (یعنی) طویٰ میں پکارا","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5729,"text":"(اور حکم دیا) کہ فرعون کے پاس جاؤ وہ سرکش ہو رہا ہے","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5730,"text":"اور (اس سے) کہو کہ کیا تو چاہتا ہے کہ پاک ہو جائے؟","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5731,"text":"اور میں تجھے تیرے پروردگار کا رستہ بتاؤں تاکہ تجھ کو خوف (پیدا) ہو","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5732,"text":"غرض انہوں نے اس کو بڑی نشانی دکھائی","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5733,"text":"مگر اس نے جھٹلایا اور نہ مانا","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5734,"text":"پھر لوٹ گیا اور تدبیریں کرنے لگا","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5735,"text":"اور (لوگوں کو) اکٹھا کیا اور پکارا","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5736,"text":"کہنے لگا کہ تمہارا سب سے بڑا مالک میں ہوں","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5737,"text":"تو خدا نے اس کو دنیا اور آخرت (دونوں) کے عذاب میں پکڑ لیا","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5738,"text":"جو شخص (خدا سے) ڈر رکھتا ہے اس کے لیے اس (قصے) میں عبرت ہے","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5739,"text":"بھلا تمہارا بنانا آسان ہے یا آسمان کا؟ اسی نے اس کو بنایا","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5740,"text":"اس کی چھت کو اونچا کیا اور پھر اسے برابر کر دیا","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5741,"text":"اور اسی نے رات کو تاریک بنایا اور (دن کو) دھوپ نکالی","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5742,"text":"اور اس کے بعد زمین کو پھیلا دیا","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5743,"text":"اسی نے اس میں سے اس کا پانی نکالا اور چارا اگایا","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5744,"text":"اور اس پر پہاڑوں کابوجھ رکھ دیا","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5745,"text":"یہ سب کچھ تمہارے اور تمہارے چارپایوں کے فائدے کے لیے (کیا)","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5746,"text":"تو جب بڑی آفت آئے گی","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5747,"text":"اس دن انسان اپنے کاموں کو یاد کرے گا","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5748,"text":"اور دوزخ دیکھنے والے کے سامنے نکال کر رکھ دی جائے گی","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5749,"text":"تو جس نے سرکشی کی","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5750,"text":"اور دنیا کی زندگی کو مقدم سمجھا","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5751,"text":"اس کا ٹھکانہ دوزخ ہے","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5752,"text":"اور جو اپنے پروردگار کے سامنے کھڑے ہونے سے ڈرتا اور جی کو خواہشوں سے روکتا رہا","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5753,"text":"اس کا ٹھکانہ بہشت ہے","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5754,"text":"(اے پیغمبر، لوگ) تم سے قیامت کے بارے میں پوچھتے ہیں کہ اس کا وقوع کب ہو گا؟","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5755,"text":"سو تم اس کے ذکر سے کس فکر میں ہو","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5756,"text":"اس کا منتہا (یعنی واقع ہونے کا وقت) تمہارے پروردگار ہی کو (معلوم ہے)","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5757,"text":"جو شخص اس سے ڈر رکھتا ہے تم تو اسی کو ڈر سنانے والے ہو","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5758,"text":"جب وہ اس کو دیکھیں گے (تو ایسا خیال کریں گے) کہ گویا (دنیا میں صرف) ایک شام یا صبح رہے تھے","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"CONSIDER those [stars] that rise only to set,","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5714,"text":"and move [in their orbits] with steady motion,","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5715,"text":"and float [through space] with floating serene,","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5716,"text":"and yet overtake [one another] with swift overtaking:","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5717,"text":"and thus they fulfil the [Creator's] behest!","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5718,"text":"[HENCE, think of] the Day when a violent convulsion will convulse [the world],","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5719,"text":"to be followed by further [convulsions]!","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5720,"text":"On that Day will [men's] hearts be throbbing,","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5721,"text":"[and] their eyes downcast...","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5722,"text":"[And yet,] some say, \"What! Are we indeed to be restored to our former state –","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5723,"text":"even though we may have become [a heap of] crumbling bones?\"","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5724,"text":"[And] they add, \"That, then, would be a return with loss!\"","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5725,"text":"[But,] then, that [Last Hour] will be [upon them of a sudden, as if it were] but a single accusing cry -","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5726,"text":"and then, lo, they will be fully awakened [to the truth]!","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5727,"text":"HAS THE STORY of Moses ever come within thy ken.","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5728,"text":"Lo! His Sustainer called out to him in the twice-hallowed valley:","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5729,"text":"\"Go unto Pharaoh - for, verily, he has transgressed all bounds of what is right -","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5730,"text":"and say [unto him], 'Art thou desirous of attaining to purity?","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5731,"text":"[If so,] then I shall guide thee towards [a cognition of] thy Sustainer, so that [henceforth] thou wilt stand in awe [of Him].’\"","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5732,"text":"And thereupon he [went to Pharaoh and] made him aware of the great wonder [of God's grace].","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5733,"text":"But [Pharaoh] gave him the lie and rebelliously rejected [all guidance],","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5734,"text":"and brusquely turned his back [on Moses];","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5735,"text":"and then he gathered [his great ones], and called [unto his people],","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5736,"text":"and said, \"I am your Lord All-Highest!\"","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5737,"text":"And thereupon God took him to task, [and made him] a warning example in the life to come as well as in this world.","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5738,"text":"In this, behold, there is a lesson indeed for all who stand in awe [of God].","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5739,"text":"[O MEN!] Are you more difficult to create than the heaven which He has built?","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5740,"text":"High has He reared its vault and formed it in accordance with what it was meant to be;","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5741,"text":"and He has made dark its night and brought forth its light of day.","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5742,"text":"And after that, the earth: wide has He spread its expanse,","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5743,"text":"and has caused its waters to come out of it, and its pastures,","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5744,"text":"and has made the mountains firm:","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5745,"text":"[all this] as a means of livelihood for you and your animals.","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5746,"text":"AND SO, when the great overwhelming event [of, resurrection] comes to pass –","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5747,"text":"on that Day man will [clearly] remember all that he has ever wrought;","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5748,"text":"and the blazing fire [of hell] will be lad open before all who [are destined to] see it.","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5749,"text":"For, unto him who shall have transgressed the bounds of what is right,","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5750,"text":"and preferred the life of this world [to the good of his soul],","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5751,"text":"that blazing fire will truly be the goal!","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5752,"text":"But unto him who shall have stood in fear of his Sustainer's Presence, and held back his inner self from base desires,","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5753,"text":"paradise will truly be the goal!","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5754,"text":"THEY WILL ASK thee [O Prophet] about the Last Hour: \"When will it come to pass?\"","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5755,"text":"[But] how couldst thou tell anything about it,","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5756,"text":"[seeing that] with thy Sustainer alone rests the beginning and the end [of all knowledge] thereof?","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5757,"text":"Thou art but [sent] to warn those who stand in awe of it.","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5758,"text":"On the Day when they behold it, [it will seem to them] as if they had tarried [in this world] no longer than one evening or [one night, ending with] its morn!","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}