{"code":200,"status":"OK","data":[{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"مَا ٱلْقَارِعَةُ","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"نَارٌ حَامِيَةٌۢ","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"کھڑ کھڑانے والی","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"کھڑ کھڑانے والی کیا ہے؟","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"تو جس کے (اعمال کے) وزن بھاری نکلیں گے","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"وہ دل پسند عیش میں ہو گا","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"اور جس کے وزن ہلکے نکلیں گے","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"اس کا مرجع ہاویہ ہے","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"دہکتی ہوئی آگ ہے","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"OH, the sudden calamity!","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"How awesome the sudden calamity!","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"And what could make thee conceive what that sudden calamity will be?","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"[It will occur] on the Day when men will be like moths swarming in confusion,","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"and the mountains will be like fluffy tufts of wool....","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"And then, he whose weight [of good deeds] is heavy in the balance","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"shall find himself in a happy' state of life;","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"whereas he whose weight is light in the balance","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"shall be engulfed by an abyss.","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"And what could make thee conceive what that [abyss] will be?","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"A fire hotly burning!","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}