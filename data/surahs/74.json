ruku":510,"hizbQuarter":230,"sajda":false},{"number":5500,"text":"اور ناپاکی سے دور رہو","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5501,"text":"اور (اس نیت سے) احسان نہ کرو کہ اس سے زیادہ کے طالب ہو","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5502,"text":"اور اپنے پروردگار کے لئے صبر کرو","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5503,"text":"جب صور پھونکا جائے گا","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5504,"text":"وہ دن کا مشکل دن ہوگا","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5505,"text":"(یعنی) کافروں پر آسان نہ ہوگا","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5506,"text":"ہمیں اس شخص سے سمجھ لینے دو جس کو ہم نے اکیلا پیدا کیا","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5507,"text":"اور مال کثیر دیا","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5508,"text":"اور (ہر وقت اس کے پاس) حاضر رہنے والے بیٹے دیئے","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5509,"text":"اور ہر طرح کے سامان میں وسعت دی","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5510,"text":"ابھی خواہش رکھتا ہے کہ اور زیادہ دیں","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5511,"text":"ایسا ہرگز نہیں ہوگا۔ یہ ہماری آیتیں کا دشمن رہا ہے","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5512,"text":"ہم اسے صعود پر چڑھائیں گے","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5513,"text":"اس نے فکر کیا اور تجویز کی","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5514,"text":"یہ مارا جائے اس نے کیسی تجویز کی","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5515,"text":"پھر یہ مارا جائے اس نے کیسی تجویز کی","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5516,"text":"پھر تامل کیا","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5517,"text":"پھر تیوری چڑھائی اور منہ بگاڑ لیا","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5518,"text":"پھر پشت پھیر کر چلا اور (قبول حق سے) غرور کیا","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5519,"text":"پھر کہنے لگا کہ یہ تو جادو ہے جو (اگلوں سے) منتقل ہوتا آیا ہے","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5520,"text":"(پھر بولا) یہ (خدا کا کلام نہیں بلکہ) بشر کا کلام ہے","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5521,"text":"ہم عنقریب اس کو سقر میں داخل کریں گے","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5522,"text":"اور تم کیا سمجھے کہ سقر کیا ہے؟","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5523,"text":"(وہ آگ ہے کہ) نہ باقی رکھے گی اور نہ چھوڑے گی","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5524,"text":"اور بدن جھلس کر سیاہ کردے گی","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5525,"text":"اس پر اُنیس داروغہ ہیں","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5526,"text":"اور ہم نے دوزخ کے داروغہ فرشتے بنائے ہیں۔ اور ان کا شمار کافروں کی آزمائش کے لئے مقرر کیا ہے (اور) اس لئے کہ اہل کتاب یقین کریں اور مومنوں کا ایمان اور زیادہ ہو اور اہل کتاب اور مومن شک نہ لائیں۔ اور اس لئے کہ جن لوگوں کے دلوں میں (نفاق کا) مرض ہے اور (جو) کافر (ہیں) کہیں کہ اس مثال (کے بیان کرنے) سے خدا کا مقصد کیا ہے؟ اسی طرح خدا جس کو چاہتا ہے گمراہ کرتا ہے اور جس کو چاہتا ہے ہدایت کرتا ہے اور تمہارے پروردگار کے لشکروں کو اس کے سوا کوئی نہیں جانتا۔ اور یہ تو بنی آدم کے لئے نصیحت ہے","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5527,"text":"ہاں ہاں (ہمیں) چاند کی قسم","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5528,"text":"اور رات کی جب پیٹھ پھیرنے لگے","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5529,"text":"اور صبح کی جب روشن ہو","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5530,"text":"کہ وہ (آگ) ایک بہت بڑی (آفت) ہے","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5531,"text":"(اور) بنی آدم کے لئے مؤجب خوف","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5532,"text":"جو تم میں سے آگے بڑھنا چاہے یا پیچھے رہنا چاہے","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5533,"text":"ہر شخص اپنے اعمال کے بدلے گرو ہے","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5534,"text":"مگر داہنی طرف والے (نیک لوگ)","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5535,"text":"(کہ) وہ باغہائے بہشت میں (ہوں گے اور) پوچھتے ہوں گے","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5536,"text":"(یعنی آگ میں جلنے والے) گنہگاروں سے","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5537,"text":"کہ تم دوزخ میں کیوں پڑے؟","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"وہ جواب دیں گے کہ ہم نماز نہیں پڑھتے تھے","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"اور نہ فقیروں کو کھانا کھلاتے تھے","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"اور اہل باطل کے ساتھ مل کر (حق سے) انکار کرتے تھے","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"اور روز جزا کو جھٹلاتے تھے","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"یہاں تک کہ ہمیں موت آگئی","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"(تو اس حال میں) سفارش کرنے والوں کی سفارش ان کے حق میں کچھ فائدہ نہ دے گی","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"ان کو کیا ہوا ہے کہ نصیحت سے روگرداں ہو رہے ہیں","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"گویا گدھے ہیں کہ بدک جاتے ہیں","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"(یعنی) شیر سے ڈر کر بھاگ جاتے ہیں","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"اصل یہ ہے کہ ان میں سے ہر شخص یہ چاہتا ہے کہ اس کے پاس کھلی ہوئی کتاب آئے","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"ایسا ہرگز نہیں ہوگا۔ حقیقت یہ ہے کہ ان کو آخرت کا خوف ہی نہیں","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"کچھ شک نہیں کہ یہ نصیحت ہے","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"تو جو چاہے اسے یاد رکھے","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"اور یاد بھی تب ہی رکھیں گے جب خدا چاہے۔ وہی ڈرنے کے لائق اور بخشش کا مالک ہے","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"O THOU [in thy solitude] enfolded!","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5497,"text":"Arise and warn!","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5498,"text":"And thy Sustainer's greatness glorify!","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5499,"text":"And thine inner self purify!","numberInSurah":4,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5500,"text":"And all defilement shun!","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5501,"text":"And do not through giving seek thyself to gain,","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5502,"text":"but unto thy Sustainer turn in patience.","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5503,"text":"And [warn all men that] when the trumpet-call [of resurrection] is sounded,","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5504,"text":"that very Day shall be a day of anguish,","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5505,"text":"not of ease, for all who [now] deny the truth!","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5506,"text":"LEAVE Me alone [to deal] with him whom I have created alone,","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5507,"text":"and to whom I have granted resources vast,","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5508,"text":"and children as [love's] witnesses,","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5509,"text":"and to whose life I gave so wide a scope:","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5510,"text":"and yet, he greedily desires that I give yet more!","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5511,"text":"Nay, verily, it is against Our messages that he knowingly, stubbornly sets himself","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5512,"text":"[and so] I shall constrain him to endure a painful uphill climb!","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5513,"text":"Behold, [when Our messages are conveyed to one who is bent on denying the truth,] he reflects and meditates [as to how to disprove them] –","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5514,"text":"and thus he destroys himself, the way he meditates:","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5515,"text":"yea, he destroys himself, the way he meditates!","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5516,"text":"and then he looks [around for new arguments],","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5517,"text":"and then he frowns and glares,","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5518,"text":"and in the end he turns his back [on Our message], and glories in his arrogance,","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5519,"text":"and says, \"All this is mere spellbinding eloquence handed down [from olden times]!","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5520,"text":"This is nothing but the word of mortal man!\"","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5521,"text":"[Hence,] I shall cause him to endure hell-fire [in the life to come]!","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5522,"text":"And what could make thee conceive what hell-fire is?","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5523,"text":"It does not allow to live, and neither leaves [to die],","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5524,"text":"making [all truth] visible to mortal man.","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5525,"text":"Over it are nineteen [powers].","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5526,"text":"For We have caused none but angelic powers to lord over the fire [of hell]; and We have not caused their number to be aught but a trial for those who are bent on denying the truth - to the end that they who have been granted revelation aforetime might be convinced [of the truth of this divine writ]; and that they who have attained to faith [in it] might grow yet more firm in their faith; and that [both] they who have been granted the earlier revelation and they who believe [in this one] might be freed of all doubt; and that they in whose hearts is disease and the who deny the truth outright might ask, \"What does [your] God mean by this parable?\" In this way God lets go astray him that wills [to go astray], and guides aright him that wills [to be guided]. And none can comprehend thy Sustainers forces save Him alone: and all this is but a reminder to mortal man.","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5527,"text":"NAY, but consider the moon!","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5528,"text":"Consider the night when it departs,","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5529,"text":"and the morn when it dawns!","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5530,"text":"Verily, that [hell-fire) is Indeed one of the great [forewarnings] –","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5531,"text":"a warning to mortal man –","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5532,"text":"to everyone of you, whether he chooses to come forward or to hang back!","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5533,"text":"[On the Day of Judgment,] every human being will be held in pledge for whatever [evil] he has wrought –","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5534,"text":"save those who shall have attained to righteousness:","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5535,"text":"[dwelling] In gardens [of paradise], they will inquire","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5536,"text":"of those who were lost in sin:","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5537,"text":"\"What has brought you into hell-fire?\"","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"They will answer: \"We were not among those who prayed;","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"and neither did we feed the needy;","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"and we were wont to indulge in sinning together with all [the others] who indulged in it;","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"and the Day of Judgment we were wont to call a lie –","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"until certainty came upon us [in death].\"","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"And so, of no benefit to them could be the intercession of any that would intercede for them.","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"WHAT, THEN, is amiss with them that they turn away from all admonition","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"as though they were terrified asses","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"fleeing from a lion?","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"Yea, everyone of them claims that he [himself] ought to have been given revelations unfolded!","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"Nay, but they do not [believe in and, hence, do not] fear the life to come.","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"Nay, verily, this is an admonition –","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"and whoever wills may take it to heart.","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"But they [who do not believe in the life to come] will not take it to heart unless God so wills: [for] He is the Fount of all God-consciousness, and the Fount of all forgiveness.","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}