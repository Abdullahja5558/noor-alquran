":518,"hizbQuarter":233,"sajda":false},{"number":5693,"text":"بےشک دوزخ گھات میں ہے","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5694,"text":"(یعنی) سرکشوں کا وہی ٹھکانہ ہے","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5695,"text":"اس میں وہ مدتوں پڑے رہیں گے","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5696,"text":"وہاں نہ ٹھنڈک کا مزہ چکھیں گے۔ نہ (کچھ) پینا (نصیب ہو گا)","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5697,"text":"مگر گرم پانی اور بہتی پیپ","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5698,"text":"(یہ) بدلہ ہے پورا پورا","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5699,"text":"یہ لوگ حساب (آخرت) کی امید ہی نہیں رکھتے تھے","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5700,"text":"اور ہماری آیتوں کو جھوٹ سمجھ کر جھٹلاتے رہتے تھے","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5701,"text":"اور ہم نے ہر چیز کو لکھ کر ضبط کر رکھا ہے","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5702,"text":"سو (اب) مزہ چکھو۔ ہم تم پر عذاب ہی بڑھاتے جائیں گے","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5703,"text":"بے شک پرہیز گاروں کے لیے کامیابی ہے","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5704,"text":"(یعنی) باغ اور انگور","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5705,"text":"اور ہم عمر نوجوان عورتیں","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5706,"text":"اور شراب کے چھلکتے ہوئے گلاس","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5707,"text":"وہاں نہ بیہودہ بات سنیں گے نہ جھوٹ (خرافات)","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5708,"text":"یہ تمہارے پروردگار کی طرف سے صلہ ہے انعام کثیر","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5709,"text":"وہ جو آسمانوں اور زمین اور جو ان دونوں میں ہے سب کا مالک ہے بڑا مہربان کسی کو اس سے بات کرنے کا یارا نہیں ہوگا","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5710,"text":"جس دن روح (الامین) اور فرشتے صف باندھ کر کھڑے ہوں گے تو کوئی بول نہ سکے گا مگر جس کو (خدائے رحمٰن) اجازت بخشے اور اس نے بات بھی درست کہی ہو","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5711,"text":"یہ دن برحق ہے۔ پس جو شخص چاہے اپنے پروردگار کے پاس ٹھکانہ بنا ئے","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5712,"text":"ہم نے تم کو عذاب سے جو عنقریب آنے والا ہے آگاہ کر دیا ہے جس دن ہر شخص ان (اعمال) کو جو اس نے آگے بھیجے ہوں گے دیکھ لے گا اور کافر کہے گا کہ اے کاش میں مٹی ہوتا","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","englishNameTranslation":"The Announcement","revelationType":"Meccan","ayahs":[{"number":5673,"text":"About what are they asking one another?","numberInSurah":1,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5674,"text":"About the great news -","numberInSurah":2,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5675,"text":"That over which they are in disagreement.","numberInSurah":3,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5676,"text":"No! They are going to know.","numberInSurah":4,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5677,"text":"Then, no! They are going to know.","numberInSurah":5,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5678,"text":"Have We not made the earth a resting place?","numberInSurah":6,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5679,"text":"And the mountains as stakes?","numberInSurah":7,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5680,"text":"And We created you in pairs","numberInSurah":8,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5681,"text":"And made your sleep [a means for] rest","numberInSurah":9,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5682,"text":"And made the night as clothing","numberInSurah":10,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5683,"text":"And made the day for livelihood","numberInSurah":11,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5684,"text":"And constructed above you seven strong [heavens]","numberInSurah":12,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5685,"text":"And made [therein] a burning lamp","numberInSurah":13,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5686,"text":"And sent down, from the rain clouds, pouring water","numberInSurah":14,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5687,"text":"That We may bring forth thereby grain and vegetation","numberInSurah":15,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5688,"text":"And gardens of entwined growth.","numberInSurah":16,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5689,"text":"Indeed, the Day of Judgement is an appointed time -","numberInSurah":17,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5690,"text":"The Day the Horn is blown and you will come forth in multitudes","numberInSurah":18,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5691,"text":"And the heaven is opened and will become gateways","numberInSurah":19,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5692,"text":"And the mountains are removed and will be [but] a mirage.","numberInSurah":20,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5693,"text":"Indeed, Hell has been lying in wait","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5694,"text":"For the transgressors, a place of return,","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5695,"text":"In which they will remain for ages [unending].","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5696,"text":"They will not taste therein [any] coolness or drink","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5697,"text":"Except scalding water and [foul] purulence -","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5698,"text":"An appropriate recompense.","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5699,"text":"Indeed, they were not expecting an account","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5700,"text":"And denied Our verses with [emphatic] denial.","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5701,"text":"But all things We have enumerated in writing.","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5702,"text":"\"So taste [the penalty], and never will We increase you except in torment.\"","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5703,"text":"Indeed, for the righteous is attainment -","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5704,"text":"Gardens and grapevines","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5705,"text":"And full-breasted [companions] of equal age","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5706,"text":"And a full cup.","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5707,"text":"No ill speech will they hear therein or any falsehood -","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5708,"text":"[As] reward from your Lord, [a generous] gift [made due by] account,","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5709,"text":"[From] the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him [authority for] speech.","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5710,"text":"The Day that the Spirit and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct.","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5711,"text":"That is the True Day; so he who wills may take to his Lord a [way of] return.","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5712,"text":"Indeed, We have warned you of a near punishment on the Day when a man will observe what his hands have put forth and the disbeliever will say, \"Oh, I wish that I were dust!\"","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false}]}]}