":518,"hizbQuarter":233,"sajda":false},{"number":5693,"text":"بےشک دوزخ گھات میں ہے","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5694,"text":"(یعنی) سرکشوں کا وہی ٹھکانہ ہے","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5695,"text":"اس میں وہ مدتوں پڑے رہیں گے","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5696,"text":"وہاں نہ ٹھنڈک کا مزہ چکھیں گے۔ نہ (کچھ) پینا (نصیب ہو گا)","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5697,"text":"مگر گرم پانی اور بہتی پیپ","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5698,"text":"(یہ) بدلہ ہے پورا پورا","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5699,"text":"یہ لوگ حساب (آخرت) کی امید ہی نہیں رکھتے تھے","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5700,"text":"اور ہماری آیتوں کو جھوٹ سمجھ کر جھٹلاتے رہتے تھے","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5701,"text":"اور ہم نے ہر چیز کو لکھ کر ضبط کر رکھا ہے","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5702,"text":"سو (اب) مزہ چکھو۔ ہم تم پر عذاب ہی بڑھاتے جائیں گے","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5703,"text":"بے شک پرہیز گاروں کے لیے کامیابی ہے","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5704,"text":"(یعنی) باغ اور انگور","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5705,"text":"اور ہم عمر نوجوان عورتیں","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5706,"text":"اور شراب کے چھلکتے ہوئے گلاس","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5707,"text":"وہاں نہ بیہودہ بات سنیں گے نہ جھوٹ (خرافات)","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5708,"text":"یہ تمہارے پروردگار کی طرف سے صلہ ہے انعام کثیر","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5709,"text":"وہ جو آسمانوں اور زمین اور جو ان دونوں میں ہے سب کا مالک ہے بڑا مہربان کسی کو اس سے بات کرنے کا یارا نہیں ہوگا","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5710,"text":"جس دن روح (الامین) اور فرشتے صف باندھ کر کھڑے ہوں گے تو کوئی بول نہ سکے گا مگر جس کو (خدائے رحمٰن) اجازت بخشے اور اس نے بات بھی درست کہی ہو","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5711,"text":"یہ دن برحق ہے۔ پس جو شخص چاہے اپنے پروردگار کے پاس ٹھکانہ بنا ئے","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5712,"text":"ہم نے تم کو عذاب سے جو عنقریب آنے والا ہے آگاہ کر دیا ہے جس دن ہر شخص ان (اعمال) کو جو اس نے آگے بھیجے ہوں گے دیکھ لے گا اور کافر کہے گا کہ اے کاش میں مٹی ہوتا","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","englishNameTranslation":"The Announcement","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5673,"text":"ABOUT WHAT do they [most often] ask one another?","numberInSurah":1,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5674,"text":"About the awesome tiding [of resurrection],","numberInSurah":2,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5675,"text":"on which they [so utterly] disagree.","numberInSurah":3,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5676,"text":"Nay, but in time they will come to understand [it]!","numberInSurah":4,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5677,"text":"And once again: Nay, but in time they will come to understand!","numberInSurah":5,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5678,"text":"HAVE WE NOT made the earth a resting-place [for you],","numberInSurah":6,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5679,"text":"and the mountains [its] pegs?","numberInSurah":7,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5680,"text":"And We have created you in pairs;","numberInSurah":8,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5681,"text":"and We have made your sleep [a symbol of] death","numberInSurah":9,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5682,"text":"and made the night [its] cloak","numberInSurah":10,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5683,"text":"and made the day [a symbol of] life.","numberInSurah":11,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5684,"text":"And We have built above you seven firmaments,","numberInSurah":12,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5685,"text":"and have placed [therein the sun,] a lamp full of blazing splendour.","numberInSurah":13,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5686,"text":"And from the wind-driven clouds We send down waters pouring in abundance,","numberInSurah":14,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5687,"text":"so that We might bring forth thereby grain, and herbs,","numberInSurah":15,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5688,"text":"and gardens dense with follage.","numberInSurah":16,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5689,"text":"VERILY, the Day of Distinction [between the true and the false] has indeed its appointed time:","numberInSurah":17,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5690,"text":"the Day when the trumpet [of resurrection] is sounded and you all come forward in multitudes;","numberInSurah":18,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5691,"text":"and when the skies are opened and become [as wide-flung] gates;","numberInSurah":19,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5692,"text":"and when the mountains are made to vanish as if they had been a mirage.","numberInSurah":20,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5693,"text":"[On that Day,] verily, hell will lie in wait [for those who deny the truth] –","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5694,"text":"a goal for all who are wont to transgress the bounds of what is right!","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5695,"text":"In it shall they remain for a long time.","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5696,"text":"Neither coolness shall they taste therein nor any [thirst-quenching] drink –","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5697,"text":"only burning despair and ice-cold darkness:","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5698,"text":"a meet requital [for their sins]!","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5699,"text":"Behold, they were not expecting to be called to account,","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5700,"text":"having given the lie to Our messages one and all:","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5701,"text":"but We have placed on record every single thing [of what they did].","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5702,"text":"[And so We shall say:] \"Taste, then, [the fruit of your evil doings,] for now We shall bestow on you nothing but more and more suffering!\"","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5703,"text":"[But,] verily for the God-conscious there is supreme fulfilment in store:","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5704,"text":"luxuriant gardens and vinyards,","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5705,"text":"and splendid companions well matched,","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5706,"text":"and a cup [of happiness] overflowing.","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5707,"text":"No empty talk will they hear in that [paradise], nor any lie.","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5708,"text":"[All this will be] a reward from thy Sustainer, a gift in accordance with [His Own] reckoning –","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5709,"text":"[a reward from] the Sustainer of the heavens and the earth and all that is between them, the Most Gracious! [And] none shall have it in their power to raise their voices unto Him","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5710,"text":"on the Day when all [human] souls and all the angels will stand up in ranks: none will speak but he to whom the Most Gracious will have given leave; and [everyone] will say [only] what is right.","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5711,"text":"That will be the Day of Ultimate Truth: whoever wills, then, let him take the path that leads towards his Sustainer!","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5712,"text":"Verily, We have warned you of suffering near at hand - [suffering] on the Day when man shall [clearly] see what his hands have sent ahead, and when he who has denied the truth shall say, \"Oh, would that I were mere dust...!\"","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}