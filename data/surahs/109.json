{"code":200,"status":"OK","data":[{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6209,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6210,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6211,"text":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6212,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"text":"(اے پیغمبر ان منکران اسلام سے) کہہ دو کہ اے کافرو!","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6209,"text":"جن (بتوں) کو تم پوچتے ہو ان کو میں نہیں پوجتا","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6210,"text":"اور جس (خدا) کی میں عبادت کرتا ہوں اس کی تم عبادت نہیں کرتے","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6211,"text":"اور (میں پھر کہتا ہوں کہ) جن کی تم پرستش کرتے ہوں ان کی میں پرستش کرنے والا نہیں ہوں","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6212,"text":"اور نہ تم اس کی بندگی کرنے والے (معلوم ہوتے) ہو جس کی میں بندگی کرتا ہوں","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"تم اپنے دین پر میں اپنے دین پر","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"text":"SAY: \"O you who deny the truth!","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6209,"text":"\"I do not worship that which you worship,","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6210,"text":"and neither do you worship that which I worship!","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6211,"text":"\"And I will not worship ~hat which you have [ever] worshipped,","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6212,"text":"and neither will you [ever] worship that which I worship.","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"Unto you, your moral law, and unto me, mine!\"","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}