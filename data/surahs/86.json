{"code":200,"status":"OK","data":[{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"وَمَا هُوَ بِٱلْهَزْلِ","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"وَأَكِيدُ كَيْدًۭا","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"آسمان اور رات کے وقت آنے والے کی قسم","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"اور تم کو کیا معلوم کہ رات کے وقت آنے والا کیا ہے","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"وہ تارا ہے چمکنے والا","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"کہ کوئی متنفس نہیں جس پر نگہبان مقرر نہیں","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"تو انسان کو دیکھنا چاہئے کہ وہ کاہے سے پیدا ہوا ہے","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"وہ اچھلتے ہوئے پانی سے پیدا ہوا ہے","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"جو پیٹھ اور سینے کے بیچ میں سے نکلتا ہے","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"بےشک خدا اس کے اعادے (یعنی پھر پیدا کرنے) پر قادر ہے","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"جس دن دلوں کے بھید جانچے جائیں گے","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"تو انسان کی کچھ پیش نہ چل سکے گی اور نہ کوئی اس کا مددگار ہو گا","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"آسمان کی قسم جو مینہ برساتا ہے","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"اور زمین کی قسم جو پھٹ جاتی ہے","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"کہ یہ کلام (حق کو باطل سے) جدا کرنے والا ہے","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"اور بیہودہ بات نہیں ہے","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"یہ لوگ تو اپنی تدبیروں میں لگ رہے ہیں","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"اور ہم اپنی تدبیر کر رہے ہیں","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"تو تم کافروں کو مہلت دو بس چند روز ہی مہلت دو","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"CONSIDER the heavens and that which comes in the night!","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"And what could make thee conceive what it is that comes in the night?","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"It is the star that pierces through [life's] darkness:","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"[for] no human being has ever been left unguarded.","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"LET MAN, then, observe out of what he has been created:","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"he has been created out of a seminal fluid","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"issuing from between the loins [of man] and the pelvic arch [of woman].","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"Now, verily, He [who thus creates man in the first instance] is well able to bring him back [to life]","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"on the Day when all secrets will be laid bare,","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"and [man] will have neither strength nor helper!","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"Consider the heavens, ever-revolving,","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"and the earth, bursting forth with plants!","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"BEHOLD, this [divine writ] is indeed a word that between truth and falsehood,","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"and is no idle tale.","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"Behold, they [who refuse to accept it] devise many a false argument [to disprove its truth];","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"but I shall bring all their scheming to nought.","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"Let, then, the deniers of the truth have their will: let them have their will for a little while.","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}