{"code":200,"status":"OK","data":[{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5995,"text":"وَلَيَالٍ عَشْرٍۢ","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5996,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5997,"text":"وَٱلَّيْلِ إِذَا يَسْرِ","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5998,"text":"هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5999,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6000,"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6001,"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6002,"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6003,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6004,"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6005,"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6006,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6007,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6008,"text":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6009,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6010,"text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6011,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6012,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6013,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6014,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6015,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6016,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6017,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6018,"text":"فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6019,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6020,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6021,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6022,"text":"فَٱدْخُلِى فِى عِبَٰدِى","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6023,"text":"وَٱدْخُلِى جَنَّتِى","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"فجر کی قسم","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5995,"text":"اور دس راتوں کی","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5996,"text":"اور جفت اور طاق کی","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5997,"text":"اور رات کی جب جانے لگے","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5998,"text":"اور بے شک یہ چیزیں عقلمندوں کے نزدیک قسم کھانے کے لائق ہیں کہ (کافروں کو ضرور عذاب ہو گا)","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5999,"text":"کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے عاد کے ساتھ کیا کیا","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6000,"text":"(جو) ارم (کہلاتے تھے اتنے) دراز قد","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6001,"text":"کہ تمام ملک میں ایسے پیدا نہیں ہوئے تھے","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6002,"text":"اور ثمود کے ساتھ (کیا کیا) جو وادئِ (قریٰ) میں پتھر تراشتے تھے (اور گھر بناتے) تھے","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6003,"text":"اور فرعون کے ساتھ (کیا کیا) جو خیمے اور میخیں رکھتا تھا","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6004,"text":"یہ لوگ ملکوں میں سرکش ہو رہے تھے","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6005,"text":"اور ان میں بہت سی خرابیاں کرتے تھے","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6006,"text":"تو تمہارے پروردگار نے ان پر عذاب کا کوڑا نازل کیا","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6007,"text":"بے شک تمہارا پروردگار تاک میں ہے","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6008,"text":"مگر انسان (عجیب مخلوق ہے کہ) جب اس کا پروردگار اس کو آزماتا ہے تو اسے عزت دیتا اور نعمت بخشتا ہے۔ تو کہتا ہے کہ (آہا) میرے پروردگار نے مجھے عزت بخشی","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6009,"text":"اور جب (دوسری طرح) آزماتا ہے کہ اس پر روزی تنگ کر دیتا ہے تو کہتا ہے کہ (ہائے) میرے پروردگار نے مجھے ذلیل کیا","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6010,"text":"نہیں بلکہ تم لوگ یتیم کی خاطر نہیں کرتے","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6011,"text":"اور نہ مسکین کو کھانا کھلانے کی ترغیب دیتے ہو","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6012,"text":"اور میراث کے مال سمیٹ کر کھا جاتے ہو","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6013,"text":"اور مال کو بہت ہی عزیز رکھتے ہو","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6014,"text":"تو جب زمین کی بلندی کوٹ کوٹ کو پست کر دی جائے گی","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6015,"text":"اور تمہارا پروردگار (جلوہ فرما ہو گا) اور فرشتے قطار باندھ باندھ کر آ موجود ہوں گے","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6016,"text":"اور دوزخ اس دن حاضر کی جائے گی تو انسان اس دن متنبہ ہو گا مگر تنبہ (سے) اسے (فائدہ) کہاں (مل سکے گا)","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6017,"text":"کہے گا کاش میں نے اپنی زندگی (جاودانی کے لیے) کچھ آگے بھیجا ہوتا","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6018,"text":"تو اس دن نہ کوئی خدا کے عذاب کی طرح کا (کسی کو) عذاب دے گا","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6019,"text":"اور نہ کوئی ویسا جکڑنا جکڑے گا","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6020,"text":"اے اطمینان پانے والی روح!","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6021,"text":"اپنے پروردگار کی طرف لوٹ چل۔ تو اس سے راضی وہ تجھ سے راضی","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6022,"text":"تو میرے (ممتاز) بندوں میں شامل ہو جا","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6023,"text":"اور میری بہشت میں داخل ہو جا","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","ayahs":[{"number":5994,"text":"By the dawn","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5995,"text":"And [by] ten nights","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5996,"text":"And [by] the even [number] and the odd","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5997,"text":"And [by] the night when it passes,","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5998,"text":"Is there [not] in [all] that an oath [sufficient] for one of perception?","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5999,"text":"Have you not considered how your Lord dealt with 'Aad -","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6000,"text":"[With] Iram - who had lofty pillars,","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6001,"text":"The likes of whom had never been created in the land?","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6002,"text":"And [with] Thamud, who carved out the rocks in the valley?","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6003,"text":"And [with] Pharaoh, owner of the stakes? -","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6004,"text":"[All of] whom oppressed within the lands","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6005,"text":"And increased therein the corruption.","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6006,"text":"So your Lord poured upon them a scourge of punishment.","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6007,"text":"Indeed, your Lord is in observation.","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6008,"text":"And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me.\"","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6009,"text":"But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6010,"text":"No! But you do not honor the orphan","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6011,"text":"And you do not encourage one another to feed the poor.","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6012,"text":"And you consume inheritance, devouring [it] altogether,","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6013,"text":"And you love wealth with immense love.","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6014,"text":"No! When the earth has been leveled - pounded and crushed -","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6015,"text":"And your Lord has come and the angels, rank upon rank,","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6016,"text":"And brought [within view], that Day, is Hell - that Day, man will remember, but what good to him will be the remembrance?","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6017,"text":"He will say, \"Oh, I wish I had sent ahead [some good] for my life.\"","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6018,"text":"So on that Day, none will punish [as severely] as His punishment,","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6019,"text":"And none will bind [as severely] as His binding [of the evildoers].","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6020,"text":"[To the righteous it will be said], \"O reassured soul,","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6021,"text":"Return to your Lord, well-pleased and pleasing [to Him],","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6022,"text":"And enter among My [righteous] servants","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6023,"text":"And enter My Paradise.\"","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false}]}]}