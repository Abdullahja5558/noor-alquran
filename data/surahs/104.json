{"code":200,"status":"OK","data":[{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6181,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6182,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6183,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6184,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6185,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6186,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6187,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6188,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6181,"text":"جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6182,"text":"(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6183,"text":"ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6184,"text":"اور تم کیا سمجھے حطمہ کیا ہے؟","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6185,"text":"وہ خدا کی بھڑکائی ہوئی آگ ہے","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6186,"text":"جو دلوں پر جا لپٹے گی","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6187,"text":"(اور) وہ اس میں بند کر دیئے جائیں گے","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6188,"text":"(یعنی آگ کے) لمبے لمبے ستونوں میں","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","ayahs":[{"number":6180,"text":"Woe to every scorner and mocker","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6181,"text":"Who collects wealth and [continuously] counts it.","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6182,"text":"He thinks that his wealth will make him immortal.","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6183,"text":"No! He will surely be thrown into the Crusher.","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6184,"text":"And what can make you know what is the Crusher?","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6185,"text":"It is the fire of Allah, [eternally] fueled,","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6186,"text":"Which mounts directed at the hearts.","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6187,"text":"Indeed, Hellfire will be closed down upon them","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6188,"text":"In extended columns.","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false}]}]}