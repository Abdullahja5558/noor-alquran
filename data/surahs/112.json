{"code":200,"status":"OK","data":[{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"ٱللَّهُ ٱلصَّمَدُ","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"معبود برحق جو بےنیاز ہے","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"اور کوئی اس کا ہمسر نہیں","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"SAY: \"He is the One God:","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"\"God the Eternal, the Uncaused Cause of All Being.","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"\"He begets not, and neither is He begotten;","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"\"and there is nothing that could be compared with Him.","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}