{"code":200,"status":"OK","data":[{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"(اے پیغمبر) اپنے پروردگار جلیل الشان کے نام کی تسبیح کرو","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"جس نے (انسان کو) بنایا پھر (اس کے اعضاء کو) درست کیا","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"اور جس نے (اس کا) اندازہ ٹہرایا (پھر اس کو) رستہ بتایا","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"اور جس نے چارہ اگایا","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"پھر اس کو سیاہ رنگ کا کوڑا کر دیا","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"ہم تمہیں پڑھا دیں گے کہ تم فراموش نہ کرو گے","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"مگر جو خدا چاہے۔ وہ کھلی بات کو بھی جانتا ہے اور چھپی کو بھی","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"ہم تم کو آسان طریقے کی توفیق دیں گے","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"سو جہاں تک نصیحت (کے) نافع (ہونے کی امید) ہو نصیحت کرتے رہو","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"جو خوف رکھتا ہے وہ تو نصیحت پکڑے گا","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"اور (بےخوف) بدبخت پہلو تہی کرے گا","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"جو (قیامت کو) بڑی (تیز) آگ میں داخل ہو گا","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"پھر وہاں نہ مرے گا اور نہ جئے گا","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"بے شک وہ مراد کو پہنچ گیا جو پاک ہوا","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"اور اپنے پروردگار کے نام کا ذکر کرتا رہا اور نماز پڑھتا رہا","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"مگر تم لوگ تو دنیا کی زندگی کو اختیار کرتے ہو","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"حالانکہ آخرت بہت بہتر اور پائندہ تر ہے","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"یہ بات پہلے صحیفوں میں (مرقوم) ہے","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"(یعنی) ابراہیم اور موسیٰ کے صحیفوں میں","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"EXTOL the limitless glory of thy Sustainer's name: [the glory of] the Al-Highest,","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"who creates [every thing], and thereupon forms it in accordance with what it is meant to be,","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"and who determines the nature [of all that exists], and thereupon guides it [towards its fulfilment],","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"and who brings forth herbage,","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"and thereupon causes it to decay into rust-brown stubble!","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"WE SHALL teach thee, and thou wilt not forget [aught of what thou art taught],","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"save what God may will [thee to forget] - for, verily, He [alone] knows all that is open to [man's] perception as well as all that is hidden [from it]","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"and [thus] shall We make easy for thee the path towards [ultimate] ease.","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"REMIND, THEN, [others of the truth, regardless of] whether this reminding [would seem to] be of use [or not]:","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"in mind will keep it he who stands in awe [of God],","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"but aloof from it will remain that most hapless wretch –","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"he who [in the life to come] shall have to endure the great fire","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"wherein he will neither die nor remain alive.","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"To happiness [in the life to come] will indeed attain he who attains to purity [in this world],","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"and remembers his Sustainer's name, and prays [unto Him].","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"But nay, [O men,] you prefer the life of this world,","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"although the life to come is better and more enduring.","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"Verily, [all] this has indeed been [said] in the earlier revelations –","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"the revelations of Abraham and Moses.","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}