{"code":200,"status":"OK","data":[{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6148,"text":"فَٱلْمُورِيَٰتِ قَدْحًۭا","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6149,"text":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6150,"text":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6151,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6152,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6153,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6154,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6155,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","numberInSurah":9,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6156,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6157,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"ان سرپٹ دوڑنے والے گھوڑوں کی قسم جو ہانپ اٹھتےہیں","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6148,"text":"پھر (پتھروں پر نعل) مار کر آگ نکالتے ہیں","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6149,"text":"پھر صبح کو چھاپہ مارتے ہیں","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6150,"text":"پھر اس میں گرد اٹھاتے ہیں","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6151,"text":"پھر اس وقت دشمن کی فوج میں جا گھستے ہیں","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6152,"text":"کہ انسان اپنے پروردگار کا احسان ناشناس (اور ناشکرا) ہے","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6153,"text":"اور وہ اس سے آگاہ بھی ہے","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6154,"text":"وہ تو مال سے سخت محبت کرنے والا ہے","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6155,"text":"کیا وہ اس وقت کو نہیں جانتا کہ جو (مردے) قبروں میں ہیں وہ باہر نکال لیے جائیں گے","numberInSurah":9,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6156,"text":"اور جو (بھید) دلوں میں ہیں وہ ظاہر کر دیئے جائیں گے","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6157,"text":"بےشک ان کا پروردگار اس روز ان سے خوب واقف ہوگا","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"Oh, the chargers that run panting,","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6148,"text":"sparks of fire striking,","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6149,"text":"rushing to assault at morn,","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6150,"text":"thereby raising clouds of dust,","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6151,"text":"thereby storming [blindly] into any host!","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6152,"text":"VERILY, towards his Sustainer man is most ungrateful","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6153,"text":"and to this, behold, he [himself] bears witness indeed:","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6154,"text":"for, verily, to the love of wealth is he most ardently devoted.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6155,"text":"But does he not know that [on the Last Day,] when all that is in the graves is raised and brought out,","numberInSurah":9,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6156,"text":"and all that is [hidden] in men's hearts is bared","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6157,"text":"that on that Day their Sustainer [will show that He] has always been fully aware of them?","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.asad","language":"en","name":"Asad","englishName":"Muhammad Asad","format":"text","type":"translation","direction":"ltr"}}]}